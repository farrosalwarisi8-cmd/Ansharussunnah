# ============================================================
# ANSHARUSSUNNAH LMS — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in the values.
# Variables marked (opsional) are not required for the app to start
# but enable additional features.

# ============================================================
# DATABASE (Prisma / PostgreSQL)
# ============================================================

# Connection string untuk Prisma (pooling via Accelerate atau PgBouncer)
DATABASE_URL="postgresql://user:password@host:5432/ansharussunnah?schema=public"

# Direct connection string (tanpa pooling) — digunakan untuk migrations
DIRECT_URL="postgresql://user:password@host:5432/ansharussunnah?schema=public"

# ============================================================
# SUPABASE (Authentication & Storage)
# ============================================================

# URL project Supabase (tersedia di Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"

# Anon key (public) — aman untuk client-side
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIs..."

# Service role key (RAHASIA) — hanya untuk server-side (admin operations)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIs..."

# ============================================================
# EMAIL (Resend)
# ============================================================

# API key dari Resend.com — digunakan untuk mengirim email kredensial
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"

# Alamat pengirim email (opsional, default: onboarding@resend.dev)
# Email dari Resend harus menggunakan domain yang sudah diverifikasi
EMAIL_FROM="Ansharussunnah LMS <noreply@ansharussunnah.sch.id)"

# Alamat reply-to email (opsional)
EMAIL_REPLY_TO="admin@ansharussunnah.sch.id"

# ============================================================
# APPLICATION
# ============================================================

# URL aplikasi (digunakan untuk email links, redirect, dll)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================
# PASSWORD ENCRYPTION (WAJIB) — KEAMANAN DATABASE
# ============================================================
# Kunci rahasia untuk mengenkripsi password cadangan akun siswa/orang tua
# sebelum disimpan di database (AES-256-GCM). Jangan bocorkan ke publik.
# Generate: `openssl rand -hex 32` (atau string acak panjang apa pun).
PASSWORD_ENCRYPTION_KEY="generate-a-long-random-secret-string"

# ============================================================
# RATE LIMITING (Upstash Redis) — OPSIONAL
# ============================================================
# Jika tidak dikonfigurasi, sistem fallback ke in-memory rate limiter
# yang TIDAK konsisten di Vercel Serverless. Sangat disarankan untuk
# production menggunakan Upstash Redis.

# URL Upstash Redis REST API
UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"

# Token Upstash Redis REST API
UPSTASH_REDIS_REST_TOKEN="AXxx..."

# Batas request per menit untuk endpoint cek pendaftaran (opsional, default: 5)
RATE_LIMIT_CEK_PENDAFTARAN="5"

# ============================================================
# SEEDING (opsional)
# ============================================================
# Password default untuk akun guru & admin keuangan saat seeding
# Jika tidak diisi, seed script akan menggunakan password hardcoded

SEED_GURU_PASSWORD="Guru123!"
SEED_KEUANGAN_PASSWORD="Keuangan123!"

# ============================================================
# CRON / SCHEDULED JOBS — OPSIONAL (dibutuhkan untuk cron SPP bulanan &
# auto-close ujian kedaluwarsa harian)
# ============================================================

# Secret acak untuk melindungi route /api/cron/* dari panggilan publik.
# Bebas generator apa pun, mis. `openssl rand -base64 32`.
CRON_SECRET="generate-a-random-long-string"

# ============================================================
# SENTRY (Error Monitoring) — OPSIONAL
# ============================================================
# Jika tidak diisi, Sentry dinonaktifkan dan app berjalan normal.

# Server-side DSN (dari Sentry > Settings > Client Keys)
SENTRY_DSN="https://xxxxx@o1.ingest.sentry.io/0000000"

# Client-side DSN (public) — dulunya NEXT_PUBLIC_SENTRY_DSN
NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@o1.ingest.sentry.io/0000000"

# Slug organisasi & project Sentry (opsional, untuk sourcemap upload)
SENTRY_ORG="your-org-slug"
SENTRY_PROJECT="your-project-slug"

