  mataPelajaran   MataPelajaran? @relation(fields: [mataPelajaranId], references: [id])
  periodeAjaran   PeriodeAjaran  @relation(fields: [periodeAjaranId], references: [id])
  siswa           Siswa          @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@unique([siswaId, tanggal, mataPelajaranId], map: "uq_absensi_siswa_tanggal_mapel")
  @@index([kelasId, tanggal])
  @@index([siswaId, tanggal])
  @@index([mataPelajaranId], map: "idx_absensi_mapel")
  @@index([periodeAjaranId])
  @@index([kelasId], map: "idx_absensi_kelas")
  @@index([periodeAjaranId], map: "idx_absensi_periode")
  @@index([siswaId], map: "idx_absensi_siswa")
  @@index([siswaId, periodeAjaranId], map: "idx_absensi_siswa_periode")
  @@index([tanggal(sort: Desc)], map: "idx_absensi_tanggal")
  @@map("absensis")
}

model NilaiRapor {
