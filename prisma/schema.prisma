  dibatalkanOlehId String?           @map("dibatalkan_oleh_id")
  waktuPembatalan  DateTime?         @map("waktu_pembatalan") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deleted_at       DateTime?         @db.Timestamptz(6)
  dibatalkanOleh   User?             @relation("TransaksiDibatalkanOleh", fields: [dibatalkanOlehId], references: [id])
  dibuatOleh       User              @relation("TransaksiDibuatOleh", fields: [dibuatOlehId], references: [id])
  kategori         KategoriTransaksi @relation(fields: [kategoriId], references: [id])

  @@index([tipe, status])
  @@index([tanggal])
  @@index([kategoriId])
  @@index([kategoriId], map: "idx_transaksi_kategori")
  @@index([status], map: "idx_transaksi_status")
  @@index([tanggal(sort: Desc)], map: "idx_transaksi_tanggal")
  @@index([tipe], map: "idx_transaksi_tipe")
  @@map("transaksi_keuangans")
}

