model Ujian {
  id              String            @id @default(cuid())
  judul           String
  deskripsi       String?
  mataPelajaranId String            @map("mata_pelajaran_id")
  kelasId         String            @map("kelas_id")
  targetGender    JenisKelamin?     @map("target_gender")
  periodeAjaranId String            @map("periode_ajaran_id")
  waktuMulai      DateTime          @map("waktu_mulai") @db.Timestamptz(3)
  waktuSelesai    DateTime          @map("waktu_selesai") @db.Timestamptz(3)
  durasiMenit     Int               @map("durasi_menit")
  status          StatusUjian       @default(DRAFT)
  // Nomor urut ujian per kelas+mapel+periode (hanya untuk ULANGAN_HARIAN).
  // UTS/Ujian Semester tidak bernomor — unik constraint Postgres memperbolehkan
  // banyak NULL, sehingga aman untuk null.
  nomorUjian      Int?              @map("nomor_ujian")
  jenisUjian      JenisUjian        @default(ULANGAN_HARIAN) @map("jenis_ujian")
  inputManual     Boolean           @default(false) @map("input_manual")
  dibuatOlehId    String            @map("dibuat_oleh_id")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  pengerjaan      PengerjaanUjian[]
  soal            SoalUjian[]
  dibuatOleh      User              @relation("UjianDibuatOleh", fields: [dibuatOlehId], references: [id])
  kelas           Kelas             @relation(fields: [kelasId], references: [id])
  mataPelajaran   MataPelajaran     @relation(fields: [mataPelajaranId], references: [id])
  periodeAjaran   PeriodeAjaran     @relation(fields: [periodeAjaranId], references: [id])

  @@unique([kelasId, mataPelajaranId, periodeAjaranId, nomorUjian], map: "uq_ujian_nomor")
  @@index([kelasId, status])
  @@index([periodeAjaranId])
  @@index([kelasId], map: "idx_ujian_kelas")
  @@index([mataPelajaranId], map: "idx_ujian_mapel")
  @@index([periodeAjaranId], map: "idx_ujian_periode")
  @@index([status], map: "idx_ujian_status")
  @@index([status, waktuSelesai], map: "idx_ujian_status_waktu_selesai")
  @@index([kelasId, periodeAjaranId, status], map: "idx_ujian_kelas_periode_status")
  @@map("ujians")
}

