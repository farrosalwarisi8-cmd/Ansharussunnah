model TransaksiKeuangan {
  id               String            @id @default(cuid())
  kategoriId       String            @map("kategori_id")
  tipe             TipeTransaksi
  nominal          Decimal           @db.Decimal(12, 2)
  deskripsi        String
  tanggal          DateTime          @db.Timestamptz(3)
