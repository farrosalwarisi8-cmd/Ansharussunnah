generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUM DEFINITIONS
// ============================================

enum Role {
  SUPER_ADMIN     // Akses ke semua fitur
  ADMIN_AKADEMIK  // Tata Usaha, Pendaftaran, Jadwal
  ADMIN_KEUANGAN  // Kasir, SPP, Akuntansi
  GURU
  SISWA
  ORANG_TUA
}

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

enum StatusPendaftaran {
  MENUNGGU_PEMBAYARAN
  MENUNGGU_VERIFIKASI
  DITERIMA
  DITOLAK
}

enum StatusVerifikasiBukti {
  PENDING
  DITERIMA
  DITOLAK
}

enum StatusUjian {
  DRAFT
  PUBLISHED
  SELESAI
}

enum TipeSoal {
  PILIHAN_GANDA
  ESAI
}

enum StatusPengerjaan {
  SEDANG_MENGERJAKAN
  SELESAI
  DINILAI
}

enum StatusAbsensi {
  HADIR
  SAKIT
  IZIN
  ALPHA
}

enum StatusPengumpulan {
  BELUM_DIKUMPULKAN
  TEPAT_WAKTU
  TERLAMBAT
  DINILAI
}

enum TipeTransaksi {
  PEMASUKAN
  PENGELUARAN
}

enum JenisTagihan {
  SPP
  UANG_GEDUNG
  SERAGAM
  BUKU
  KEGIATAN
  LAINNYA
}

enum StatusTagihan {
  BELUM_BAYAR
  MENUNGGU_VERIFIKASI
  DIBAYAR_SEBAGIAN
  SUDAH_BAYAR
  TERLAMBAT
  DIBATALKAN
}

enum StatusPembayaran {
  PENDING
  DIKONFIRMASI
  DITOLAK
}

enum StatusTransaksi {
  AKTIF
  DIBATALKAN
}

enum StatusOrangTua {
  MASIH_HIDUP
  SUDAH_MENINGGAL
  TIDAK_DIKETAHUI
}

enum StatusWali {
  SAMA_DENGAN_AYAH
  SAMA_DENGAN_IBU
  LAINNYA
}

enum Kewarganegaraan {
  WNI
  WNA
}

// ============================================
// AUTH & USER MODELS
// ============================================

model User {
  id                 String    @id @default(cuid())
  email              String
  nama               String
  role               Role
  avatar             String?
  authId             String    @map("auth_id")
  aktif              Boolean   @default(true)
  isAdmin            Boolean   @default(false) @map("is_admin")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastPasswordChange DateTime? @map("last_password_change")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([authId, role])

  guru     Guru?
  siswa    Siswa?
  orangTua OrangTua?

  verifikasiBuktiTransfer BuktiTransferPendaftaran[] @relation("VerifiedBy")
  verifikasiPendaftaran   Pendaftaran[]              @relation("VerifiedBy")
  passwordResetTokens     PasswordResetToken[]

  // Audit trail
  ujianDibuat            Ujian[]              @relation("UjianDibuatOleh")
  absensiDiinput         Absensi[]            @relation("AbsensiDiinputOleh")
  tugasDibuat            Tugas[]              @relation("TugasDibuatOleh")
  penilaianTugas         PengumpulanTugas[]   @relation("TugasDinilaiOleh")
  penilaianEsai          JawabanSiswa[]       @relation("EsaiDinilaiOleh")
  catatanRaporDibuat     CatatanRapor[]       @relation("CatatanRaporOleh")
  nilaiRaporDiinput      NilaiRapor[]         @relation("NilaiRaporDiinputOleh")
  transaksiDibuat        TransaksiKeuangan[]  @relation("TransaksiDibuatOleh")
  transaksiDibatalkan    TransaksiKeuangan[]  @relation("TransaksiDibatalkanOleh")
  pembayaranDikonfirmasi PembayaranSiswa[]    @relation("PembayaranDikonfirmasi")
  tagihanDibatalkan      TagihanSiswa[]       @relation("TagihanDibatalkan")
  materiDiunggah         MateriPembelajaran[] @relation("MateriDiunggahOleh")

  @@map("users")
}

model Guru {
  id      String  @id @default(cuid())
  userId  String  @unique @map("user_id")
  nip     String? @unique
  jabatan String?
  noHp    String? @map("no_hp")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  waliKelas    Kelas[]           @relation("WaliKelas")
  mengajar     GuruKelas[]
  catatanRapor CatatanRapor[]
  ekskulDibina Ekstrakurikuler[] @relation("EkskulPembina")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("gurus")
}

model Siswa {
  id                String            @id @default(cuid())
  userId            String            @unique @map("user_id")
  nisn              String?           @unique
  nis               String?           @unique // Nomor Induk Siswa Lokal
  agama             String?
  tempatLahir       String?           @map("tempat_lahir")
  tanggalLahir      DateTime?         @map("tanggal_lahir")
  jenisKelamin      JenisKelamin      @map("jenis_kelamin")
  alamat            String?
  noHpSiswa         String?           @map("no_hp_siswa")
  namaAyahKandung   String?           @map("nama_ayah_kandung")
  statusAyahKandung StatusOrangTua?   @map("status_ayah_kandung")
  nikAyah           String?           @map("nik_ayah")
  namaIbuKandung    String?           @map("nama_ibu_kandung")
  statusIbuKandung  StatusOrangTua?   @map("status_ibu_kandung")
  nikIbu            String?           @map("nik_ibu")
  statusWali        StatusWali?       @map("status_wali")
  namaWali          String?           @map("nama_wali")
  kewarganegaraan   Kewarganegaraan?  @default(WNI)
  kitas             String?
  asalNegara        String?           @map("asal_negara")
  kelasId           String?           @map("kelas_id")
  pendaftaranId     String?           @unique @map("pendaftaran_id")
  sppKhusus         Decimal?          @map("spp_khusus") @db.Decimal(12, 2)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kelas       Kelas?       @relation(fields: [kelasId], references: [id])
  pendaftaran Pendaftaran? @relation(fields: [pendaftaranId], references: [id])
  orangTua    ParentStudent[]

  pengerjaanUjian  PengerjaanUjian[]
  absensi          Absensi[]
  pengumpulanTugas PengumpulanTugas[]
  catatanRapor     CatatanRapor[]
  nilaiRapor       NilaiRapor[]
  tagihanSiswa     TagihanSiswa[]
  riwayatKelas     RiwayatKelasSiswa[]
  ekskul           AnggotaEkskul[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kelasId])
  @@map("siswas")
}

model OrangTua {
  id     String  @id @default(cuid())
  userId String  @unique @map("user_id")
  noHp   String? @map("no_hp")
  alamat String?

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  siswa ParentStudent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("orang_tuas")
}

model ParentStudent {
  id         String @id @default(cuid())
  orangTuaId String @map("orang_tua_id")
  siswaId    String @map("siswa_id")
  hubungan   String @default("Orang Tua")

  orangTua OrangTua @relation(fields: [orangTuaId], references: [id], onDelete: Cascade)
  siswa    Siswa    @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([orangTuaId, siswaId])
  @@index([siswaId])
  @@map("parent_students")
}

// ============================================
// MASTER DATA (AKADEMIK)
// ============================================

model MataPelajaran {
  id         String   @id @default(cuid())
  kode       String   @unique // Cth: MTK, BIN
  nama       String   // Cth: Matematika, B. Indonesia
  kelompok   String?  // Cth: A (Wajib), B (Peminatan)
  jenjangId  String?  @map("jenjang_id")
  aktif      Boolean  @default(true)

  jenjang    Jenjang?  @relation(fields: [jenjangId], references: [id], onDelete: SetNull)
  guruKelas  GuruKelas[]
  mapelKelas MapelKelas[]
  ujian      Ujian[]
  tugas      Tugas[]
  materi     MateriPembelajaran[]
  nilaiRapor NilaiRapor[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([jenjangId])
  @@map("mata_pelajarans")
}

model Jenjang {
  id              String  @id @default(cuid())
  nama            String  @unique
  urutan          Int     @unique
  aktif           Boolean @default(true)
  tarifSppBulanan Decimal? @map("tarif_spp_bulanan") @db.Decimal(12, 2)

  kelas             Kelas[]
  pendaftaran       Pendaftaran[]
  mataPelajaran     MataPelajaran[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("jenjangs")
}

model Kelas {
  id          String  @id @default(cuid())
  nama        String
  jenjangId   String  @map("jenjang_id")
  waliKelasId String? @map("wali_kelas_id")
  kapasitas   Int     @default(30)
  aktif       Boolean @default(true)

  jenjang       Jenjang     @relation(fields: [jenjangId], references: [id], onDelete: Cascade)
  waliKelas     Guru?       @relation("WaliKelas", fields: [waliKelasId], references: [id])

  siswa                   Siswa[]
  pendaftaran             Pendaftaran[]
  guruMengajar            GuruKelas[]
  mapelTersedia           MapelKelas[]
  ujian                   Ujian[]
  absensi                 Absensi[]
  tugas                   Tugas[]
  materi                  MateriPembelajaran[]
  nilaiRapor              NilaiRapor[]
  riwayatSebagaiKelas     RiwayatKelasSiswa[] @relation("RiwayatKelasSiswa")
  riwayatSebagaiKelasAsal RiwayatKelasSiswa[] @relation("RiwayatKelasSiswaAsal")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([nama, jenjangId])
  @@index([jenjangId])
  @@map("kelas")
}

model PeriodeAjaran {
  id             String   @id @default(cuid())
  nama           String   @unique
  tahunAjaran    String   @map("tahun_ajaran")
  semester       String
  tanggalMulai   DateTime @map("tanggal_mulai")
  tanggalSelesai DateTime @map("tanggal_selesai")
  aktif          Boolean  @default(false)

  ujian         Ujian[]
  tugas         Tugas[]
  absensi       Absensi[]
  catatanRapor  CatatanRapor[]
  nilaiRapor    NilaiRapor[]
  riwayatKelas  RiwayatKelasSiswa[]
  materi        MateriPembelajaran[]
  anggotaEkskul AnggotaEkskul[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([aktif])
  @@map("periode_ajarans")
}

model GuruKelas {
  id              String @id @default(cuid())
  guruId          String @map("guru_id")
  kelasId         String @map("kelas_id")
  mataPelajaranId String @map("mata_pelajaran_id")

  guru          Guru          @relation(fields: [guruId], references: [id], onDelete: Cascade)
  kelas         Kelas         @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  mataPelajaran MataPelajaran @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([guruId, kelasId, mataPelajaranId])
  @@index([kelasId])
  @@index([guruId])
  @@map("guru_kelas")
}

model MapelKelas {
  id          String @id @default(cuid())
  mapelId     String @map("mapel_id")
  kelasId     String @map("kelas_id")

  mataPelajaran MataPelajaran @relation(fields: [mapelId], references: [id], onDelete: Cascade)
  kelas         Kelas         @relation(fields: [kelasId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([mapelId, kelasId])
  @@index([kelasId])
  @@index([mapelId])
  @@map("mapel_kelas")
}

// ============================================
// PENDAFTARAN & RESET PASSWORD
// ============================================

model Pendaftaran {
  id                   String            @id @default(cuid())
  nomorPendaftaran     String            @unique @map("nomor_pendaftaran")
  namaLengkap          String            @map("nama_lengkap")
  tempatLahir          String            @map("tempat_lahir")
  tanggalLahir         DateTime          @map("tanggal_lahir")
  jenisKelamin         JenisKelamin      @map("jenis_kelamin")
  agama                String?
  alamatSiswa          String            @map("alamat_siswa")
  nisn                 String?
  noHpSiswa            String?           @map("no_hp_siswa")
  namaOrangTua         String            @map("nama_orang_tua")
  noHpOrangTua         String            @map("no_hp_orang_tua")
  emailOrangTua        String            @map("email_orang_tua")
  alamatOrangTua       String?           @map("alamat_orang_tua")
  namaAyahKandung      String?           @map("nama_ayah_kandung")
  statusAyahKandung    StatusOrangTua?   @map("status_ayah_kandung")
  nikAyah              String?           @map("nik_ayah")
  namaIbuKandung       String?           @map("nama_ibu_kandung")
  statusIbuKandung     StatusOrangTua?   @map("status_ibu_kandung")
  nikIbu               String?           @map("nik_ibu")
  statusWali           StatusWali?       @map("status_wali")
  namaWali             String?           @map("nama_wali")
  kewarganegaraan      Kewarganegaraan?  @default(WNI)
  kitas                String?
  asalNegara           String?           @map("asal_negara")
  jenjangTujuanId      String            @map("jenjang_tujuan_id")
  kelasTujuanId        String?           @map("kelas_tujuan_id")
  dokKartuKeluarga     String?           @map("dok_kartu_keluarga")
  dokAkteLahir         String?           @map("dok_akte_lahir")
  dokFoto              String?           @map("dok_foto")
  dokLainnya           String[]          @default([]) @map("dok_lainnya")
  status               StatusPendaftaran @default(MENUNGGU_PEMBAYARAN)
  biayaPendaftaran     Decimal           @map("biaya_pendaftaran") @db.Decimal(12, 2)
  catatanAdmin         String?           @map("catatan_admin")
  alasanPenolakan      String?           @map("alasan_penolakan")
  diverifikasiOlehId   String?           @map("diverifikasi_oleh_id")
  waktuVerifikasi      DateTime?         @map("waktu_verifikasi")

  jenjangTujuan    Jenjang                    @relation(fields: [jenjangTujuanId], references: [id])
  kelasTujuan      Kelas?                     @relation(fields: [kelasTujuanId], references: [id])
  diverifikasiOleh User?                      @relation("VerifiedBy", fields: [diverifikasiOlehId], references: [id])
  buktiTransfer    BuktiTransferPendaftaran[]
  siswa            Siswa?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("pendaftarans")
}

model BuktiTransferPendaftaran {
  id                 String   @id @default(cuid())
  pendaftaranId      String   @map("pendaftaran_id")
  urlFile            String   @map("url_file")
  namaFile           String   @map("nama_file")
  ukuranFile         Int?     @map("ukuran_file")
  status             StatusVerifikasiBukti @default(PENDING)
  catatanVerifikasi  String?  @map("catatan_verifikasi")
  diverifikasiOlehId String?  @map("diverifikasi_oleh_id")
  waktuVerifikasi    DateTime? @map("waktu_verifikasi")

  pendaftaran      Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
  diverifikasiOleh User?       @relation("VerifiedBy", fields: [diverifikasiOlehId], references: [id])

  waktuUpload DateTime @default(now()) @map("waktu_upload")

  @@map("bukti_transfer_pendaftarans")
}

model PasswordResetToken {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  kodeOtpHash String   @map("kode_otp_hash")
  expiredAt   DateTime @map("expired_at")
  digunakan   Boolean  @default(false)
  jumlahGagal Int      @default(0) @map("jumlah_gagal")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, digunakan])
  @@index([expiredAt])
  @@map("password_reset_tokens")
}

// ============================================
// LMS: UJIAN, TUGAS, MATERI, ABSENSI
// ============================================

model MateriPembelajaran {
  id              String   @id @default(cuid())
  judul           String
  deskripsi       String?
  mataPelajaranId String   @map("mata_pelajaran_id")
  urlFile         String?  @map("url_file")  
  urlLink         String?  @map("url_link")  
  kelasId         String   @map("kelas_id")
  periodeAjaranId String   @map("periode_ajaran_id")
  diunggahOlehId  String   @map("diunggah_oleh_id")

  kelas         Kelas         @relation(fields: [kelasId], references: [id])
  periodeAjaran PeriodeAjaran @relation(fields: [periodeAjaranId], references: [id])
  mataPelajaran MataPelajaran @relation(fields: [mataPelajaranId], references: [id])
  diunggahOleh  User          @relation("MateriDiunggahOleh", fields: [diunggahOlehId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kelasId, mataPelajaranId])
  @@index([periodeAjaranId])
  @@map("materi_pembelajarans")
}

model Ujian {
  id              String      @id @default(cuid())
  judul           String
  deskripsi       String?
  mataPelajaranId String      @map("mata_pelajaran_id")
  kelasId         String      @map("kelas_id")
  periodeAjaranId String      @map("periode_ajaran_id")
  waktuMulai      DateTime    @map("waktu_mulai")
  waktuSelesai    DateTime    @map("waktu_selesai")
  durasiMenit     Int         @map("durasi_menit")
  status          StatusUjian @default(DRAFT)
  dibuatOlehId    String      @map("dibuat_oleh_id")

  kelas         Kelas         @relation(fields: [kelasId], references: [id])
  periodeAjaran PeriodeAjaran @relation(fields: [periodeAjaranId], references: [id])
  mataPelajaran MataPelajaran @relation(fields: [mataPelajaranId], references: [id])
  dibuatOleh    User          @relation("UjianDibuatOleh", fields: [dibuatOlehId], references: [id])

  soal        SoalUjian[]
  pengerjaan  PengerjaanUjian[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kelasId, status])
  @@index([periodeAjaranId])
  @@map("ujians")
}

model SoalUjian {
  id            String   @id @default(cuid())
  ujianId       String   @map("ujian_id")
  nomorSoal     Int      @map("nomor_soal")
  pertanyaan    String
  tipe          TipeSoal
  bobot         Int      @default(1)
  kunciEsai     String?  @map("kunci_esai")

  ujian        Ujian          @relation(fields: [ujianId], references: [id], onDelete: Cascade)
  opsi         OpsiJawaban[]
  jawabanSiswa JawabanSiswa[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([ujianId, nomorSoal])
  @@index([ujianId])
  @@map("soal_ujians")
}

model OpsiJawaban {
  id        String  @id @default(cuid())
  soalId    String  @map("soal_id")
  label     String  // A, B, C, D
  teks      String
  benar     Boolean @default(false)

  soal SoalUjian @relation(fields: [soalId], references: [id], onDelete: Cascade)

  @@unique([soalId, label])
  @@index([soalId])
  @@map("opsi_jawabans")
}

model PengerjaanUjian {
  id              String           @id @default(cuid())
  ujianId         String           @map("ujian_id")
  siswaId         String           @map("siswa_id")
  waktuMulai      DateTime         @default(now()) @map("waktu_mulai")
  waktuSubmit     DateTime?        @map("waktu_submit")
  status          StatusPengerjaan @default(SEDANG_MENGERJAKAN)
  nilaiTotal      Decimal?         @map("nilai_total") @db.Decimal(6, 2)
  nilaiPg         Decimal?         @map("nilai_pg") @db.Decimal(6, 2)
  nilaiEsai       Decimal?         @map("nilai_esai") @db.Decimal(6, 2)
  submitTerlambat Boolean          @default(false) @map("submit_terlambat")

  ujian   Ujian          @relation(fields: [ujianId], references: [id], onDelete: Cascade)
  siswa   Siswa          @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  jawaban JawabanSiswa[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([ujianId, siswaId])
  @@index([siswaId])
  @@index([status])
  @@map("pengerjaan_ujians")
}

model JawabanSiswa {
  id             String   @id @default(cuid())
  pengerjaanId   String   @map("pengerjaan_id")
  soalId         String   @map("soal_id")
  opsiDipilihId  String?  @map("opsi_dipilih_id")
  jawabanEsai    String?  @map("jawaban_esai")
  nilaiSoal      Decimal? @map("nilai_soal") @db.Decimal(6, 2)
  benar          Boolean?
  catatanGuru    String?  @map("catatan_guru")
  dinilaiOlehId  String?  @map("dinilai_oleh_id")
  waktuPenilaian DateTime? @map("waktu_penilaian")

  pengerjaan  PengerjaanUjian @relation(fields: [pengerjaanId], references: [id], onDelete: Cascade)
  soal        SoalUjian       @relation(fields: [soalId], references: [id])
  dinilaiOleh User?           @relation("EsaiDinilaiOleh", fields: [dinilaiOlehId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([pengerjaanId, soalId])
  @@index([pengerjaanId])
  @@index([soalId])
  @@map("jawaban_siswas")
}

model Tugas {
  id              String   @id @default(cuid())
  judul           String
  deskripsi       String
  mataPelajaranId String   @map("mata_pelajaran_id")
  kelasId         String   @map("kelas_id")
  periodeAjaranId String   @map("periode_ajaran_id")
  deadline        DateTime
  lampiranUrl     String?  @map("lampiran_url")
  dibuatOlehId    String   @map("dibuat_oleh_id")

  kelas         Kelas              @relation(fields: [kelasId], references: [id])
  periodeAjaran PeriodeAjaran      @relation(fields: [periodeAjaranId], references: [id])
  mataPelajaran MataPelajaran      @relation(fields: [mataPelajaranId], references: [id])
  dibuatOleh    User               @relation("TugasDibuatOleh", fields: [dibuatOlehId], references: [id])
  pengumpulan   PengumpulanTugas[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kelasId, deadline])
  @@index([periodeAjaranId])
  @@map("tugas")
}

model PengumpulanTugas {
  id           String            @id @default(cuid())
  tugasId      String            @map("tugas_id")
  siswaId      String            @map("siswa_id")
  urlFile      String            @map("url_file")
  namaFile     String            @map("nama_file")
  ukuranFile   Int?              @map("ukuran_file")
  waktuKumpul  DateTime          @default(now()) @map("waktu_kumpul")
  status       StatusPengumpulan @default(TEPAT_WAKTU)
  nilai        Decimal?          @db.Decimal(6, 2)
  feedback     String?
  jumlahRevisi Int               @default(0) @map("jumlah_revisi")
  dinilaiOlehId  String?         @map("dinilai_oleh_id")
  waktuPenilaian DateTime?       @map("waktu_penilaian")

  tugas       Tugas @relation(fields: [tugasId], references: [id], onDelete: Cascade)
  siswa       Siswa @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  dinilaiOleh User? @relation("TugasDinilaiOleh", fields: [dinilaiOlehId], references: [id])

  riwayat RiwayatPengumpulanTugas[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tugasId, siswaId])
  @@index([tugasId, status])
  @@index([siswaId])
  @@map("pengumpulan_tugas")
}

model RiwayatPengumpulanTugas {
  id              String   @id @default(cuid())
  pengumpulanId   String   @map("pengumpulan_id")
  urlFile         String   @map("url_file")
  namaFile        String   @map("nama_file")
  waktuKumpul     DateTime @map("waktu_kumpul")
  status          StatusPengumpulan

  pengumpulan PengumpulanTugas @relation(fields: [pengumpulanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([pengumpulanId])
  @@map("riwayat_pengumpulan_tugas")
}

model Absensi {
  id              String        @id @default(cuid())
  siswaId         String        @map("siswa_id")
  kelasId         String        @map("kelas_id")
  periodeAjaranId String        @map("periode_ajaran_id")
  tanggal         DateTime      @db.Date
  status          StatusAbsensi
  keterangan      String?
  diinputOlehId   String        @map("diinput_oleh_id")

  siswa         Siswa         @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  kelas         Kelas         @relation(fields: [kelasId], references: [id])
  periodeAjaran PeriodeAjaran @relation(fields: [periodeAjaranId], references: [id])
  diinputOleh   User          @relation("AbsensiDiinputOleh", fields: [diinputOlehId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([siswaId, tanggal])
  @@index([kelasId, tanggal])
  @@index([siswaId, tanggal])
  @@index([periodeAjaranId])
  @@map("absensis")
}

// ============================================
// RAPOR & EKSTRAKURIKULER
// ============================================

model NilaiRapor {
  id                    String   @id @default(cuid())
  siswaId               String   @map("siswa_id")
  periodeAjaranId       String   @map("periode_ajaran_id")
  mataPelajaranId       String   @map("mata_pelajaran_id")
  kelasId               String   @map("kelas_id")
  nilaiPengetahuan      Decimal  @map("nilai_pengetahuan") @db.Decimal(5, 2)
  predikatPengetahuan   String   @map("predikat_pengetahuan")
  deskripsiPengetahuan  String?  @map("deskripsi_pengetahuan")
  nilaiKeterampilan     Decimal? @map("nilai_keterampilan") @db.Decimal(5, 2)
  predikatKeterampilan  String?  @map("predikat_keterampilan")
  deskripsiKeterampilan String?  @map("deskripsi_keterampilan")
  diinputOlehId         String   @map("diinput_oleh_id")

  siswa         Siswa         @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  periodeAjaran PeriodeAjaran @relation(fields: [periodeAjaranId], references: [id])
  mataPelajaran MataPelajaran @relation(fields: [mataPelajaranId], references: [id])
  kelas         Kelas         @relation(fields: [kelasId], references: [id])
  diinputOleh   User          @relation("NilaiRaporDiinputOleh", fields: [diinputOlehId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([siswaId, periodeAjaranId, mataPelajaranId])
  @@index([siswaId, periodeAjaranId])
  @@map("nilai_rapors")
}

model CatatanRapor {
  id              String   @id @default(cuid())
  siswaId         String   @map("siswa_id")
  periodeAjaranId String   @map("periode_ajaran_id")
  waliKelasId     String   @map("wali_kelas_id")
  catatan         String
  ranking         Int?
  dibuatOlehId    String   @map("dibuat_oleh_id")

  siswa         Siswa         @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  periodeAjaran PeriodeAjaran @relation(fields: [periodeAjaranId], references: [id])
  waliKelas     Guru          @relation(fields: [waliKelasId], references: [id])
  dibuatOleh    User          @relation("CatatanRaporOleh", fields: [dibuatOlehId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([siswaId, periodeAjaranId])
  @@index([siswaId])
  @@index([periodeAjaranId])
  @@map("catatan_rapors")
}

model Ekstrakurikuler {
  id        String  @id @default(cuid())
  nama      String  @unique
  deskripsi String?
  pembinaId String? @map("pembina_id")
  aktif     Boolean @default(true)

  pembina Guru?           @relation("EkskulPembina", fields: [pembinaId], references: [id])
  anggota AnggotaEkskul[]

  createdAt DateTime @default(now()) @map("created_at")
  @@map("ekstrakurikuler")
}

model AnggotaEkskul {
  id              String  @id @default(cuid())
  ekskulId        String  @map("ekskul_id")
  siswaId         String  @map("siswa_id")
  periodeAjaranId String  @map("periode_ajaran_id")
  nilai           String?
  deskripsi       String?

  ekskul        Ekstrakurikuler @relation(fields: [ekskulId], references: [id], onDelete: Cascade)
  siswa         Siswa           @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  periodeAjaran PeriodeAjaran   @relation(fields: [periodeAjaranId], references: [id])

  @@unique([ekskulId, siswaId, periodeAjaranId])
  @@map("anggota_ekskul")
}

// ============================================
// KEUANGAN SEKOLAH (SPP & NON-SPP)
// ============================================

model TagihanSiswa {
  id               String        @id @default(cuid())
  siswaId          String        @map("siswa_id")
  jenisTagihan     JenisTagihan  @default(SPP) @map("jenis_tagihan")
  namaTagihan      String        @map("nama_tagihan") // Cth: "SPP Jan 25" atau "Uang Gedung"
  bulan            Int?          // Digunakan jika SPP (1-12)
  tahun            Int?          // Digunakan jika SPP
  nominal          Decimal       @db.Decimal(12, 2)
  jatuhTempo       DateTime      @map("jatuh_tempo")
  status           StatusTagihan @default(BELUM_BAYAR)
  totalTerbayar    Decimal?      @map("total_terbayar") @db.Decimal(12, 2)
  alasanPembatalan String?       @map("alasan_pembatalan")
  dibatalkanOlehId String?       @map("dibatalkan_oleh_id")
  waktuPembatalan  DateTime?     @map("waktu_pembatalan")

  siswa          Siswa             @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  dibatalkanOleh User?             @relation("TagihanDibatalkan", fields: [dibatalkanOlehId], references: [id])
  pembayaran     PembayaranSiswa[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([siswaId, status])
  @@index([status, jatuhTempo])
  @@unique([siswaId, bulan, tahun], map: "tagihan_siswas_siswa_bulan_tahun_unique")
  @@map("tagihan_siswas")
}

model PembayaranSiswa {
  id                 String           @id @default(cuid())
  tagihanId          String           @map("tagihan_id")
  nominalDibayar     Decimal          @map("nominal_dibayar") @db.Decimal(12, 2)
  tanggalBayar       DateTime         @map("tanggal_bayar")
  metodeBayar        String           @map("metode_bayar")
  urlBukti           String?          @map("url_bukti")
  namaBukti          String?          @map("nama_bukti")
  catatan            String?
  statusPembayaran   StatusPembayaran @default(PENDING) @map("status_pembayaran")
  alasanPenolakan    String?          @map("alasan_penolakan")
  dikonfirmasiOlehId String?          @map("dikonfirmasi_oleh_id")
  waktuKonfirmasi    DateTime?        @map("waktu_konfirmasi")

  tagihan          TagihanSiswa @relation(fields: [tagihanId], references: [id], onDelete: Cascade)
  dikonfirmasiOleh User?        @relation("PembayaranDikonfirmasi", fields: [dikonfirmasiOlehId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tagihanId])
  @@index([tanggalBayar])
  @@map("pembayaran_siswas")
}

model KategoriTransaksi {
  id        String        @id @default(cuid())
  nama      String        @unique
  tipe      TipeTransaksi
  aktif     Boolean       @default(true)
  deskripsi String?

  transaksi TransaksiKeuangan[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tipe, aktif])
  @@map("kategori_transaksis")
}

model TransaksiKeuangan {
  id               String          @id @default(cuid())
  kategoriId       String          @map("kategori_id")
  tipe             TipeTransaksi
  nominal          Decimal         @db.Decimal(12, 2)
  deskripsi        String
  tanggal          DateTime
  urlBukti         String?         @map("url_bukti")
  namaBukti        String?         @map("nama_bukti")
  status           StatusTransaksi @default(AKTIF)
  dibuatOlehId     String          @map("dibuat_oleh_id")
  alasanPembatalan String?         @map("alasan_pembatalan")
  dibatalkanOlehId String?         @map("dibatalkan_oleh_id")
  waktuPembatalan  DateTime?       @map("waktu_pembatalan")

  kategori       KategoriTransaksi @relation(fields: [kategoriId], references: [id])
  dibuatOleh     User              @relation("TransaksiDibuatOleh", fields: [dibuatOlehId], references: [id])
  dibatalkanOleh User?             @relation("TransaksiDibatalkanOleh", fields: [dibatalkanOlehId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tipe, status])
  @@index([tanggal])
  @@index([kategoriId])
  @@map("transaksi_keuangans")
}

// ============================================
// AUDIT TRAIL: LOGIN ATTEMPTS
// ============================================

model LoginAudit {
  id        String   @id @default(cuid())
  email     String   // email yang dicoba login (normalized lowercase)
  ip        String?  @map("ip_address") // IP address pelaku
  userAgent String?  @map("user_agent") // User-Agent browser
  status    String   // SUCCESS atau FAILED
  reason    String?  // alasan kegagalan (misal: "Invalid credentials", "Rate limited")
  createdAt DateTime @default(now()) @map("created_at")

  // Index untuk query dashboard keamanan & cleanup lama
  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("login_audits")
}

// ============================================
// RIWAYAT HISTORIS
// ============================================

model RiwayatKelasSiswa {
  id              String  @id @default(cuid())
  siswaId         String  @map("siswa_id")
  kelasId         String  @map("kelas_id")
  periodeAjaranId String  @map("periode_ajaran_id")
  kelasAsalId     String? @map("kelas_asal_id")

  siswa         Siswa         @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  kelas         Kelas         @relation("RiwayatKelasSiswa", fields: [kelasId], references: [id])
  kelasAsal     Kelas?        @relation("RiwayatKelasSiswaAsal", fields: [kelasAsalId], references: [id])
  periodeAjaran PeriodeAjaran @relation(fields: [periodeAjaranId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([siswaId, periodeAjaranId])
  @@index([kelasId])
  @@index([periodeAjaranId])
  @@map("riwayat_kelas_siswas")
}