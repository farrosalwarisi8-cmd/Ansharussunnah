generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                     @id @default(cuid())
  email                   String
  nama                    String
  role                    Role
  avatar                  String?
  authId                  String                     @map("auth_id") @db.Uuid
  aktif                   Boolean                    @default(true)
  mustChangePassword      Boolean                    @default(false) @map("must_change_password")
  lastPasswordChange      DateTime?                  @map("last_password_change") @db.Timestamptz(3)
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  isAdmin                 Boolean                    @default(false) @map("is_admin")
  username                String?                    @unique
  deleted_at              DateTime?                  @db.Timestamptz(6)
  absensiDiinput          Absensi[]                  @relation("AbsensiDiinputOleh")
  verifikasiBuktiTransfer BuktiTransferPendaftaran[] @relation("VerifiedBy")
  catatanRaporDibuat      CatatanRapor[]             @relation("CatatanRaporOleh")
  guru                    Guru?
  penilaianEsai           JawabanSiswa[]             @relation("EsaiDinilaiOleh")
  materiDiunggah          MateriPembelajaran[]       @relation("MateriDiunggahOleh")
  nilaiRaporDiinput       NilaiRapor[]               @relation("NilaiRaporDiinputOleh")
  notifikasi              notifikasi[]
  orangTua                OrangTua?
  passwordResetTokens     PasswordResetToken[]
  pembayaranDikonfirmasi  PembayaranSiswa[]          @relation("PembayaranDikonfirmasi")
  verifikasiPendaftaran   Pendaftaran[]              @relation("VerifiedBy")
  verifikasiEmailManual   Pendaftaran[]              @relation("EmailVerifiedManuallyBy")
  kontakWaliDikonfirmasi  Pendaftaran[]              @relation("KontakWaliDikonfirmasiBy")
  penilaianTugas          PengumpulanTugas[]         @relation("TugasDinilaiOleh")
  penilaianUjianManual    PengerjaanUjian[]          @relation("PengerjaanDinilaiOleh")
  pengumumans             pengumumans[]
  siswa                   Siswa?
  tagihanDibatalkan       TagihanSiswa[]             @relation("TagihanDibatalkan")
  transaksiDibatalkan     TransaksiKeuangan[]        @relation("TransaksiDibatalkanOleh")
  transaksiDibuat         TransaksiKeuangan[]        @relation("TransaksiDibuatOleh")
  tugasDibuat             Tugas[]                    @relation("TugasDibuatOleh")
  ujianDibuat             Ujian[]                    @relation("UjianDibuatOleh")

  @@unique([authId, role], map: "uq_users_authid_role")
  @@index([authId], map: "idx_users_auth_id")
  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

model Guru {
  id           String            @id @default(cuid())
  userId       String            @unique @map("user_id")
  nip          String?           @unique
  jabatan      String?
  noHp         String?           @map("no_hp")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  jenisKelamin JenisKelamin?     @map("jenis_kelamin")
  deleted_at   DateTime?         @db.Timestamptz(6)
  catatanRapor CatatanRapor[]
  ekskulDibina Ekstrakurikuler[] @relation("EkskulPembina")
  mengajar     GuruKelas[]
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  waliKelas    Kelas[]           @relation("WaliKelas")

  @@index([userId], map: "idx_gurus_user")
  @@map("gurus")
}

model Siswa {
  id                String              @id @default(cuid())
  userId            String              @unique @map("user_id")
  nisn              String?             @unique
  nis               String?             @unique
  agama             String?
  tempatLahir       String?             @map("tempat_lahir")
  tanggalLahir      DateTime?           @map("tanggal_lahir") @db.Timestamptz(3)
  jenisKelamin      JenisKelamin        @map("jenis_kelamin")
  alamat            String?
  kelasId           String?             @map("kelas_id")
  pendaftaranId     String?             @unique @map("pendaftaran_id")
  sppKhusus         Decimal?            @map("spp_khusus") @db.Decimal(12, 2)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  noHpSiswa         String?             @map("no_hp_siswa")
  namaAyahKandung   String?             @map("nama_ayah_kandung")
  statusAyahKandung StatusOrangTua?     @map("status_ayah_kandung")
  nikAyah           String?             @map("nik_ayah")
  namaIbuKandung    String?             @map("nama_ibu_kandung")
  statusIbuKandung  StatusOrangTua?     @map("status_ibu_kandung")
  nikIbu            String?             @map("nik_ibu")
  statusWali        StatusWali?         @map("status_wali")
  namaWali          String?             @map("nama_wali")
  kewarganegaraan   Kewarganegaraan?    @default(WNI)
  kitas             String?
  asalNegara        String?             @map("asal_negara")
  dokKartuKeluarga  String?             @map("dok_kartu_keluarga")
  dokAkteLahir      String?             @map("dok_akte_lahir")
  dokFoto           String?             @map("dok_foto")
  dokLainnya        String[]            @default([]) @map("dok_lainnya")
  deleted_at        DateTime?           @db.Timestamptz(6)
  absensi           Absensi[]
  ekskul            AnggotaEkskul[]
  catatanRapor      CatatanRapor[]
  nilaiRapor        NilaiRapor[]
  orangTua          ParentStudent[]
  pengerjaanUjian   PengerjaanUjian[]
  pengumpulanTugas  PengumpulanTugas[]
  riwayatKelas      RiwayatKelasSiswa[]
  kelas             Kelas?              @relation(fields: [kelasId], references: [id])
  pendaftaran       Pendaftaran?        @relation(fields: [pendaftaranId], references: [id])
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagihanSiswa      TagihanSiswa[]

  @@index([kelasId])
  @@index([kelasId], map: "idx_siswas_kelas")
  @@index([pendaftaranId], map: "idx_siswas_pendaftaran")
  @@index([userId], map: "idx_siswas_user")
  @@map("siswas")
}

model OrangTua {
  id         String          @id @default(cuid())
  userId     String          @unique @map("user_id")
  noHp       String?         @map("no_hp")
  alamat     String?
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deleted_at DateTime?       @db.Timestamptz(6)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  siswa      ParentStudent[]

  @@index([userId], map: "idx_ortu_user")
  @@map("orang_tuas")
}

model ParentStudent {
  id         String   @id @default(cuid())
  orangTuaId String   @map("orang_tua_id")
  siswaId    String   @map("siswa_id")
  hubungan   String   @default("Orang Tua")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  orangTua   OrangTua @relation(fields: [orangTuaId], references: [id], onDelete: Cascade)
  siswa      Siswa    @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@unique([orangTuaId, siswaId])
  @@index([siswaId])
  @@index([orangTuaId], map: "idx_parent_students_ortu")
  @@index([siswaId], map: "idx_parent_students_siswa")
  @@map("parent_students")
}

model MataPelajaran {
  id           String               @id @default(cuid())
  kode         String               @unique
  nama         String
  kelompok     String?
  aktif        Boolean              @default(true)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  jenjangId    String?              @map("jenjang_id")
  jenisKelamin JenisKelamin?        @map("jenis_kelamin")
  guruKelas    GuruKelas[]
  mapelKelas   MapelKelas[]
  jenjang      Jenjang?             @relation(fields: [jenjangId], references: [id])
  materi       MateriPembelajaran[]
  nilaiRapor   NilaiRapor[]
  tugas        Tugas[]
  ujian        Ujian[]
  absensi      Absensi[]

  @@index([jenjangId])
  @@index([jenjangId], map: "idx_mapel_jenjang")
  @@map("mata_pelajarans")
}

model Jenjang {
  id                   String          @id @default(cuid())
  nama                 String          @unique
  urutan               Int             @unique
  aktif                Boolean         @default(true)
  tarifSppBulanan      Decimal?        @map("tarif_spp_bulanan") @db.Decimal(12, 2)
  // Biaya PPDB per jenjang (diatur admin). null = pakai default (lihat src/lib/biaya-ppdb.ts).
  biayaPendaftaranPPDB Decimal?        @map("biaya_pendaftaran_ppdb") @db.Decimal(12, 2)
  biayaUangGedung      Decimal?        @map("biaya_uang_gedung") @db.Decimal(12, 2)
  biayaSarpras         Decimal?        @map("biaya_sarpras") @db.Decimal(12, 2)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  kelas                Kelas[]
  mataPelajaran        MataPelajaran[]
  pendaftaran          Pendaftaran[]

  @@map("jenjangs")
}

// Pengaturan global biaya PPDB: rekening tujuan transfer & kontak konfirmasi WA.
// Satu baris tunggal (id = 1). Diatur admin via /dashboard/biaya-ppdb.
model PengaturanPPDB {
  id             Int      @id @default(1)
  bankNama       String   @default("BRI") @map("bank_nama")
  bankNoRekening String   @default("321301015889536") @map("bank_no_rekening")
  bankAtasNama   String   @default("Sadiman") @map("bank_atas_nama")
  kontakWa       String   @default("6285702854133") @map("kontak_wa")
  namaKontakWa   String   @default("Ust. Abu Wafidah") @map("nama_kontak_wa")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("pengaturan_ppdb")
}

model Kelas {
  id                      String               @id @default(cuid())
  nama                    String
  jenjangId               String               @map("jenjang_id")
  waliKelasId             String?              @map("wali_kelas_id")
  kapasitas               Int                  @default(30)
  aktif                   Boolean              @default(true)
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  jenisKelamin            JenisKelamin?        @map("jenis_kelamin")
  absensi                 Absensi[]
  guruMengajar            GuruKelas[]
  jenjang                 Jenjang              @relation(fields: [jenjangId], references: [id], onDelete: Cascade)
  waliKelas               Guru?                @relation("WaliKelas", fields: [waliKelasId], references: [id])
  mapelTersedia           MapelKelas[]
  materi                  MateriPembelajaran[]
  nilaiRapor              NilaiRapor[]
  pendaftaran             Pendaftaran[]
  pengumumans             pengumumans[]
  riwayatSebagaiKelasAsal RiwayatKelasSiswa[]  @relation("RiwayatKelasSiswaAsal")
  riwayatSebagaiKelas     RiwayatKelasSiswa[]  @relation("RiwayatKelasSiswa")
  siswa                   Siswa[]
  tugas                   Tugas[]
  ujian                   Ujian[]

  @@unique([nama, jenjangId])
  @@index([jenjangId])
  @@index([jenjangId], map: "idx_kelas_jenjang")
  @@index([waliKelasId], map: "idx_kelas_wali")
  @@map("kelas")
}

model PeriodeAjaran {
  id             String               @id @default(cuid())
  nama           String               @unique
  tahunAjaran    String               @map("tahun_ajaran")
  semester       String
  tanggalMulai   DateTime             @map("tanggal_mulai") @db.Timestamptz(3)
  tanggalSelesai DateTime             @map("tanggal_selesai") @db.Timestamptz(3)
  aktif          Boolean              @default(false)
  // Tanggal pembuatan rapor akhir semester — diatur oleh admin (opsional).
  tanggalRapor   DateTime?            @map("tanggal_rapor") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  absensi        Absensi[]
  anggotaEkskul  AnggotaEkskul[]
  catatanRapor   CatatanRapor[]
  materi         MateriPembelajaran[]
  nilaiRapor     NilaiRapor[]
  riwayatKelas   RiwayatKelasSiswa[]
  tugas          Tugas[]
  ujian          Ujian[]

  @@unique([tahunAjaran, semester], map: "uq_periode_nama")
  @@index([aktif])
  @@map("periode_ajarans")
}

model GuruKelas {
  id              String        @id @default(cuid())
  guruId          String        @map("guru_id")
  kelasId         String        @map("kelas_id")
  mataPelajaranId String        @map("mata_pelajaran_id")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  guru            Guru          @relation(fields: [guruId], references: [id], onDelete: Cascade)
  kelas           Kelas         @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  mataPelajaran   MataPelajaran @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)

  @@unique([guruId, kelasId, mataPelajaranId])
  @@index([kelasId])
  @@index([guruId])
  @@index([guruId], map: "idx_guru_kelas_guru")
  @@index([kelasId], map: "idx_guru_kelas_kelas")
  @@index([mataPelajaranId], map: "idx_guru_kelas_mapel")
  @@map("guru_kelas")
}

model MapelKelas {
  id            String        @id @default(cuid())
  mapelId       String        @map("mapel_id")
  kelasId       String        @map("kelas_id")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  kelas         Kelas         @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  mataPelajaran MataPelajaran @relation(fields: [mapelId], references: [id], onDelete: Cascade)

  @@unique([mapelId, kelasId])
  @@index([kelasId])
  @@index([mapelId])
  @@map("mapel_kelas")
}

model Pendaftaran {
  id                                    String                     @id @default(cuid())
  nomorPendaftaran                      String                     @unique @map("nomor_pendaftaran")
  // Kredensial upload publik disimpan sebagai SHA-256, bukan plaintext, supaya
  // bocornya dump database tidak langsung berarti kredensial valid. Token
  // aslinya hanya ada satu kali di respon pendaftaran (localStorage klien).
  // NULL = belum di-backfill (baris rusak) -> fail-closed saat verifikasi.
  tokenAksesHash                        String?                    @unique @map("token_akses_hash")
  // Batas akhir token akses. Setelah lewat, pemilik tidak lagi bisa mengunggah
  // bukti transfer/dokumen lewat alur publik — dilengkapi dari dashboard setelah
  // pendaftaran diterima. NULL = dianggap kedaluwarsa (fail-closed).
  // `@db.Timestamptz(3)` WAJIB: kolom di DB bertipe timestamptz. Tanpa
  // anotasi ini Prisma membacanya sebagai timestamp tanpa timezone, dan
  // `migrate dev` lalu menulis ALTER COLUMN SET DATA TYPE tanpa diminta — hilangnya
  // zona waktu, sekaligus membuat drift yang sulit dilacak.
  // Tanpa `@default` dengan sengaja. Default pernah ada (90 hari dari
  // now()), tapi bertentangan dengan prinsip fail-closed: kalau ada insert
  // yang lupa mengisinya, NULL lebih baik daripada 90 hari akses diam-diam —
  // `isTokenAksesBelumKedaluwarsa(null)` mengembalikan FALSE, jadi NULL
  // langsung berarti kedaluwarsa dan kesalahannya ketahuan.
  //
  // `createPendaftaran` selalu mengirim nilainya secara eksplisit
  // (`hitungTokenAksesExpiraAt()`), jadi tidak ada jalur yang bergantung pada
  // default. Baris lama sudah di-backfill di migration 20260928000000.
  tokenAksesExpiraAt                    DateTime?                  @map("token_akses_expira_at") @db.Timestamptz(3)
  namaLengkap                           String                     @map("nama_lengkap")
  tempatLahir                           String                     @map("tempat_lahir")
  tanggalLahir                          DateTime                   @map("tanggal_lahir") @db.Timestamptz(3)
  jenisKelamin                          JenisKelamin               @map("jenis_kelamin")
  alamatSiswa                           String                     @map("alamat_siswa")
  nisn                                  String?
  namaOrangTua                          String                     @map("nama_orang_tua")
  noHpOrangTua                          String                     @map("no_hp_orang_tua")
  emailOrangTua                         String                     @map("email_orang_tua")
  // ================= KOLOM OTP LEGACY (DEPRECATED) =================
  // Kedua kolom di bawah milik alur "verifikasi email via OTP" yang SUDAH
  // DIHAPUS dari pendaftaran. Kolomnya DIPERTAHANKAN, bukan dihapus, karena
  // baris pendaftaran lama di produksi masih memakainya dan nilainya adalah
  // bagian dari jejak audit yang tidak boleh ditulis ulang.
  //
  // Kontrak yang WAJIB dijaga setelah penghapusan alur OTP:
  //   1. Tidak boleh dibaca sebagai gerbang alur baru apa pun
  //      (bukan syarat upload dokumen, upload bukti transfer, maupun approval).
  //   2. Tidak boleh diisi untuk pendaftaran baru — `createPendaftaran`
  //      mengirimnya eksplisit `null`.
  //   3. Tidak ada lagi UI/action yang menambahkannya.
  // Gerbang approval yang menggantikannya: `kontakWaliDikonfirmasiAt` (lihat
  // blok di bawahnya).
  //
  // `emailOrangTuaTerverifikasiAt`: kapan email pernah terverifikasi OTP.
  // NULL = belum pernah (termasuk semua pendaftaran baru).
  emailOrangTuaTerverifikasiAt          DateTime?                  @map("email_orang_tua_terverifikasi_at") @db.Timestamptz(3)
  // `emailOrangTuaDiverifikasiOtpAt`: bukti NYATA pemilik email selesai
  // memasukkan kode OTP. NULL = belum pernah selesai OTP (termasuk semua
  // baris grandfathering yang hanya terisi kolom pertama).
  emailOrangTuaDiverifikasiOtpAt        DateTime?                  @map("email_orang_tua_diverifikasi_otp_at") @db.Timestamptz(3)
  // ============ KONFIRMASI KONTAK WALI (gerbang approval baru) ============
  // Sejak OTP email dihapus dari alur pendaftaran, pemeriksaan "apakah orang
  // tua/wali ini bisa dihubungi dan datanya benar" dilakukan MANUAL oleh
  // panitia sebelum pendaftaran boleh DITERIMA. Empat kolom di bawah adalah
  // gerbang + jejak auditnya, sengaja TERPISAH dari
  // `emailOrangTuaTerverifikasiAt` (kolom warisan OTP) supaya makna auditnya
  // tidak tertukar: kolom lama berarti "diverifikasi via OTP di masa lalu",
  // kolom baru berarti "panitia mengonfirmasi kontak secara langsung".
  //
  // NULL = belum dikonfirmasi → approval DITERIMA ditolak server dengan pesan
  // yang jelas (lihat verifikasiPendaftaran di src/actions/verifikasi.ts).
  kontakWaliDikonfirmasiAt     DateTime?                  @map("kontak_wali_dikonfirmasi_at") @db.Timestamptz(3)
  kontakWaliDikonfirmasiOlehId String?                    @map("kontak_wali_dikonfirmasi_oleh_id")
  kontakWaliDikonfirmasiOleh   User?                      @relation("KontakWaliDikonfirmasiBy", fields: [kontakWaliDikonfirmasiOlehId], references: [id], onDelete: Restrict)
  // Enum string bebas ala repo: WHATSAPP | TELEPON | LANGSUNG. Divalidasi di
  // layer action (zod), bukan enum DB, agar penambahan metode tidak butuh
  // migration lagi.
  metodeKonfirmasiKontak       String?                    @map("metode_konfirmasi_kontak")
  catatanKonfirmasiKontak      String?                    @map("catatan_konfirmasi_kontak")

  // Jejak verifikasi MANUAL committee, terpisah dari `catatanAdmin`.
  //
  // @deprecated Alur verifikasi email (termasuk jalur manual ini) sudah dihapus
  // dari pendaftaran. Ketiga kolom dipertahankan HANYA sebagai arsip data lama;
  // tidak ada lagi action/UI yang menulisnya, dan tidak dipakai sebagai gerbang
  // apa pun. Jejak pemeriksaan kontak yang aktif adalah blok
  // `kontakWaliDikonfirmasi*` di atas.
  //
  // Kenapa kolom sendiri: `catatanAdmin` ditimpa setiap kali ada approval /
  // penolakan (`catatanAdmin: catatanAdmin || null`). Kalau jejak manual ikut
  // menumpang di sana, begitu panitia menyetujui pendaftaran, bukti bahwa email
  // ini diverifikasi manual hilang permanen dan tidak bisa direkonstruksi
  // dari kolom mana pun.
  //
  // Tiga kolom, bukan satu: kapan (audit), siapa (akuntabilitas), dan alasan
  // (konteks) — ketiganya wajib ada bersama, jadi dipisah agar tidak ada
  // keadaan setengah seperti "waktu terisi tapi alasan kosong".
  //
  // NULL = tidak diverifikasi manual (mungkin via OTP, mungkin belum sama
  // sekali).
  emailOrangTuaDiverifikasiManualAt     DateTime?                  @map("email_orang_tua_diverifikasi_manual_at") @db.Timestamptz(3)
  emailOrangTuaDiverifikasiManualOlehId String?                    @map("email_orang_tua_diverifikasi_manual_oleh_id")
  emailOrangTuaDiverifikasiManualOleh   User?                      @relation("EmailVerifiedManuallyBy", fields: [emailOrangTuaDiverifikasiManualOlehId], references: [id], onDelete: Restrict)
  alasanVerifikasiEmailManual           String?                    @map("alasan_verifikasi_email_manual")
  alamatOrangTua                        String?                    @map("alamat_orang_tua")
  jenjangTujuanId                       String                     @map("jenjang_tujuan_id")
  kelasTujuanId                         String?                    @map("kelas_tujuan_id")
  dokKartuKeluarga                      String?                    @map("dok_kartu_keluarga")
  dokAkteLahir                          String?                    @map("dok_akte_lahir")
  dokFoto                               String?                    @map("dok_foto")
  dokLainnya                            String[]                   @default([]) @map("dok_lainnya")
  status                                StatusPendaftaran          @default(MENUNGGU_PEMBAYARAN)
  // Snapshot nominal per komponen saat pendaftaran dibuat (kebal perubahan tarif).
  biayaPendaftaran                      Decimal                    @map("biaya_pendaftaran") @db.Decimal(12, 2)
  biayaUangGedung                       Decimal                    @default(0) @map("biaya_uang_gedung") @db.Decimal(12, 2)
  biayaSarpras                          Decimal                    @default(0) @map("biaya_sarpras") @db.Decimal(12, 2)
  // Rekening & kontak WA efektif saat pendaftaran dibuat (bila null, tampilkan nilai berlaku saat itu).
  bankNama                              String?                    @map("bank_nama")
  bankNoRekening                        String?                    @map("bank_no_rekening")
  bankAtasNama                          String?                    @map("bank_atas_nama")
  kontakWa                              String?                    @map("kontak_wa")
  catatanAdmin                          String?                    @map("catatan_admin")
  alasanPenolakan                       String?                    @map("alasan_penolakan")
  diverifikasiOlehId                    String?                    @map("diverifikasi_oleh_id")
  waktuVerifikasi                       DateTime?                  @map("waktu_verifikasi") @db.Timestamptz(3)
  createdAt                             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  agama                                 String?
  noHpSiswa                             String?                    @map("no_hp_siswa")
  namaAyahKandung                       String?                    @map("nama_ayah_kandung")
  statusAyahKandung                     StatusOrangTua?            @map("status_ayah_kandung")
  nikAyah                               String?                    @map("nik_ayah")
  namaIbuKandung                        String?                    @map("nama_ibu_kandung")
  statusIbuKandung                      StatusOrangTua?            @map("status_ibu_kandung")
  nikIbu                                String?                    @map("nik_ibu")
  statusWali                            StatusWali?                @map("status_wali")
  namaWali                              String?                    @map("nama_wali")
  kewarganegaraan                       Kewarganegaraan?           @default(WNI)
  kitas                                 String?
  asalNegara                            String?                    @map("asal_negara")
  deleted_at                            DateTime?                  @db.Timestamptz(6)
  buktiTransfer                         BuktiTransferPendaftaran[]
  diverifikasiOleh                      User?                      @relation("VerifiedBy", fields: [diverifikasiOlehId], references: [id])
  jenjangTujuan                         Jenjang                    @relation(fields: [jenjangTujuanId], references: [id])
  kelasTujuan                           Kelas?                     @relation(fields: [kelasTujuanId], references: [id])
  siswa                                 Siswa?
  otpVerifikasiEmail                    OtpVerifikasiEmail[]

  @@index([status])
  @@index([createdAt(sort: Desc)], map: "idx_pendaftaran_created")
  @@index([jenjangTujuanId], map: "idx_pendaftaran_jenjang")
  @@index([status], map: "idx_pendaftaran_status")
  @@index([status, createdAt(sort: Desc)], map: "idx_pendaftaran_status_created")
  @@index([status, id(sort: Desc)], map: "idx_pendaftaran_status_id")
  // Dua index di bawah dibuat lewat SQL mentah di migrasi. Kalau tidak
  // didaftarkan di sini, `migrate dev` akan menganggapnya drift dan
  // menghapusnya tanpa tanya. Prisma 6.19 belum mendukung klausa `WHERE`
  // pada `@@index`, jadi index parsial hanya bisa hidup lewat SQL mentah —
  // dan justru karena itu WAJIB dicatat di sini agar selamat.
  //
  // Index parsial "menunggu + berkas kurang" (idx_pendaftaran_menunggu_berkas_kurang)
  // juga SQL mentah (migration 20260930120000) dan sengaja TIDAK didaftarkan di
  // sini karena bentuknya parsial — kalau didaftarkan sebagai index biasa,
  // migrate dev akan mencoba membuat ulang versi non-parsialnya.
  @@index([emailOrangTuaDiverifikasiOtpAt], map: "idx_pendaftarans_email_otp")
  @@index([emailOrangTuaDiverifikasiManualAt], map: "pendaftaran_email_manual_idx")
  @@index([kontakWaliDikonfirmasiOlehId], map: "idx_pendaftaran_kontak_wali_oleh")
  @@map("pendaftarans")
}

// Draft pendaftaran tersimpan di server (lapisan 2 dari sistem draft hybrid).
//
// Lapisan 1 adalah localStorage di perangkat pendaftar (lihat
// src/lib/pendaftaran-draft-client.ts) — cepat, tapi hilang bila storage
// dibersihkan/perangkat berganti. Lapisan ini menjamin draft tetap pulih dari
// perangkat mana pun selama pemiliknya masih memegang resume token.
//
// Keamanan: resumeTokenHash adalah SHA-256 dari resume token — token plaintext
// TIDAK pernah disimpan di database, hanya diberikan ke klien SATU kali saat
// draft dibuat (pola sama dengan tokenAksesHash di Pendaftaran). Draft tidak
// bisa dibaca/diubah/dihapus tanpa resume token yang cocok; tidak ada jalur
// pencarian berdasarkan email/nama/HP tanpa token.
//
// Idempotensi finalisasi: saat pendaftaran berhasil dibuat, draft ditandai
// `finalizedAt` + `nomorPendaftaran` dalam transaksi yang sama dengan create.
// Submit ganda/retry dengan draftToken yang sama mengembalikan nomor yang
// sudah ada, bukan membuat pendaftaran kedua.
//
// TTL & retensi: draft kedaluwarsa 30 hari sejak update terakhir (expiresAt);
// pembersihan oleh cron harian /api/cron/bersihkan-token — draft expired
// dihapus, draft finalized disimpan 90 hari untuk audit lalu dibuang.
model PendaftaranDraft {
  id              String    @id @default(cuid())
  resumeTokenHash String    @unique @map("resume_token_hash")
  payload         Json
  lastStep        Int       @default(1) @map("last_step")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  finalizedAt     DateTime? @map("finalized_at") @db.Timestamptz(3)
  nomorPendaftaran String?  @unique @map("nomor_pendaftaran")

  @@index([expiresAt], map: "idx_pendaftaran_draft_expired")
  @@index([finalizedAt], map: "idx_pendaftaran_draft_finalized")
  @@map("pendaftaran_drafts")
}

/// DEPRECATED — tabel OTP verifikasi email pendaftaran.
///
/// Tabel ini milik alur yang sudah dihapus: pendaftaran TIDAK lagi mengirim
/// OTP, dan tidak ada lagi action/UI yang membuat atau memverifikasinya.
/// Tabelnya TIDAK dihapus dari database produksi karena masih menyimpan baris
/// pendaftaran lama beserta jejak auditorsinya (kode sudah berupa bcrypt hash,
/// jadi tidak ada kode OTP yang tersimpan dalam bentuk bisa dipakai lagi).
///
/// Yang boleh dilakukan: dibaca untuk audit legacy, dan baris lamanya dibuang
/// oleh cron /api/cron/bersihkan-token setelah lewat retensi.
/// Yang TIDAK boleh: membuat baris baru, atau menjadikannya gerbang alur.
model OtpVerifikasiEmail {
  id            String   @id @default(cuid())
  pendaftaranId String   @map("pendaftaran_id")
  email         String
  kodeOtpHash   String   @map("kode_otp_hash")
  expiredAt     DateTime @map("expired_at") @db.Timestamptz(3)
  digunakan     Boolean  @default(false)
  jumlahGagal   Int      @default(0) @map("jumlah_gagal")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  pendaftaran Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)

  @@index([pendaftaranId, digunakan], map: "idx_otp_email_pendaftaran_aktif")
  @@index([expiredAt], map: "idx_otp_email_expired")
  @@map("otp_verifikasi_email")
}

