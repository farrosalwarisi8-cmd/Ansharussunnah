model CatatanRapor {
  id              String        @id @default(cuid())
  siswaId         String        @map("siswa_id")
  periodeAjaranId String        @map("periode_ajaran_id")
  waliKelasId     String        @map("wali_kelas_id")
  // Jenis rapor dibedakan via kolom `bulan`:
  // 0 = Rapor Akhir Semester (rapor besar, mencakup seluruh periode);
  // 1-12 = Rapor Bulanan (bulan kalender).
  bulan           Int           @default(0) @map("bulan")
  catatan         String
  ranking         Int?
  // Penilaian sikap & perilaku yang diinput MANUAL oleh wali kelas/admin.
  kedisiplinan    Decimal?      @map("kedisiplinan") @db.Decimal(5, 2)
  kemandirian     Decimal?      @map("kemandirian") @db.Decimal(5, 2)
  tingkahLaku     String?       @map("tingkah_laku")
  prestasi        String?       @map("prestasi")
  dibuatOlehId    String        @map("dibuat_oleh_id")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  dibuatOleh      User          @relation("CatatanRaporOleh", fields: [dibuatOlehId], references: [id])
  periodeAjaran   PeriodeAjaran @relation(fields: [periodeAjaranId], references: [id])
  siswa           Siswa         @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  waliKelas       Guru          @relation(fields: [waliKelasId], references: [id])

  @@unique([siswaId, periodeAjaranId, bulan])
  @@index([siswaId])
  @@index([periodeAjaranId])
  @@map("catatan_rapors")
}

model Ekstrakurikuler {
  id        String          @id @default(cuid())
  nama      String          @unique
  deskripsi String?
  pembinaId String?         @map("pembina_id")
  aktif     Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  anggota   AnggotaEkskul[]
  pembina   Guru?           @relation("EkskulPembina", fields: [pembinaId], references: [id])

  @@map("ekstrakurikuler")
}

model AnggotaEkskul {
  id              String          @id @default(cuid())
  ekskulId        String          @map("ekskul_id")
  siswaId         String          @map("siswa_id")
  periodeAjaranId String          @map("periode_ajaran_id")
  deskripsi       String?
  nilai           Decimal?        @db.Decimal
  ekskul          Ekstrakurikuler @relation(fields: [ekskulId], references: [id], onDelete: Cascade)
